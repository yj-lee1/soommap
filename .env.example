# Copy this file to .env.local. Never commit .env.local or paste keys into chat.
# These are server-only values. Do not add NEXT_PUBLIC_ to a secret.

# Seoul Open Data Plaza API key (required for the Hangang locations).
SEOUL_API_KEY=
SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088

# Public Seoul snapshots only. Keep live defaults; fixtures use a separate namespace.
DATA_CACHE_NAMESPACE=soommap-seoul-live-v1
DATA_CACHE_SECONDS=300

# Choose provider/model and approve the usage budget before a paid API check.
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
AI_API_KEY=
AI_BUDGET_USD=20
# This records the approved total; it is not a provider-side spending cap.

# Shared atomic usage ledger for the public AI endpoint (Upstash Redis Free).
# Server-only; use a dedicated database with eviction and auto-upgrade disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Other hosts only: set a header your reverse proxy OVERWRITES with the actual client IP.
# On Vercel its verified x-vercel-forwarded-for header is used automatically.
TRUSTED_CLIENT_IP_HEADER=

# Authentication for the temporary setup-check endpoint.
# Generate a random value locally; keep it out of URLs and browser code.
SETUP_CHECK_TOKEN=

# TMAP: separate approved development/review budget KRW 5,000.
# paid only after the account owner enables the metered summary API product.
TMAP_API_KEY=
TMAP_BILLING_MODE=free
